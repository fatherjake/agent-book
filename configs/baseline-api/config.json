{
  "id": "baseline-api",
  "description": "API baseline (the runner's own agent loop over the Anthropic API; needs ANTHROPIC_API_KEY): Sonnet 5.5, prompt caching on, all tools, no context compaction.",
  "backend": "api",
  "provider": "anthropic",
  "model": "claude-sonnet-5-5",
  "maxOutputTokensPerCall": 16000,
  "promptCaching": true,
  "designDelivery": "inline-image",
  "inlineSpecFiles": [
    "requirements.md",
    "api-contract.yaml",
    "design-tokens.md"
  ],
  "context": {
    "strategy": "none"
  },
  "limits": {
    "maxTotalTokens": 3000000,
    "maxModelCalls": 150,
    "maxRuntimeSec": 2400
  }
}
