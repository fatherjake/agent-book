#!/bin/bash
# uiseed: after `app start`, creates a ready-to-use test fixture in the dev DB with ONE rails runner call:
# a confirmed+approved user with the onboarding modal dismissed, an OAuth token (read write follow),
# and one public status. Prints one line: TOKEN=.. SID=.. AID=.. EMAIL=.. PASSWORD=.. BASE=..
# Also writes /tmp/pwlib.js (helpers for Playwright scripts run through /opt/frugal/task/pw-node).
PORT=${1:-3000}
cat > /tmp/uiseed.rb <<'RB'
email = 'ui@example.com'
u = User.find_by(email: email) || User.create!(email: email, password: 'Passw0rd!long', password_confirmation: 'Passw0rd!long',
  account_attributes: { username: 'uiuser' }, agreement: true, confirmed_at: Time.now.utc, approved: true)
u.update!(confirmed_at: Time.now.utc, approved: true)
ws = Web::Setting.find_or_initialize_by(user: u)
ws.data = { 'introductionVersion' => 99_999_999 }
ws.save!
app = Doorkeeper::Application.find_or_create_by!(name: 'uiseed', redirect_uri: 'urn:ietf:wg:oauth:2.0:oob', scopes: 'read write follow')
t = Doorkeeper::AccessToken.create!(application: app, resource_owner_id: u.id, scopes: 'read write follow')
s = Status.create!(account: u.account, text: 'seeded status for ui check', visibility: :public)
puts "UISEED TOKEN=#{t.token} SID=#{s.id} AID=#{u.account_id}"
RB
cat > /tmp/pwlib.js <<JS
// const { login, api, BASE, EMAIL } = require('/tmp/pwlib.js');
const BASE = 'http://127.0.0.1:$PORT';
const EMAIL = 'ui@example.com', PASSWORD = 'Passw0rd!long';
async function login(page) {
  await page.goto(BASE + '/auth/sign_in');
  await page.fill('#user_email', EMAIL);
  await page.fill('#user_password', PASSWORD);
  await Promise.all([page.waitForNavigation({ timeout: 60000 }).catch(() => {}), page.click('button[type=submit]')]);
}
// api(token, 'POST', '/api/v1/statuses/1/x') -> {status, body}
async function api(token, method, path) {
  const r = await fetch(BASE + path, { method, headers: { Authorization: 'Bearer ' + token } });
  let body = null; try { body = await r.json(); } catch (e) {}
  return { status: r.status, body };
}
module.exports = { BASE, EMAIL, PASSWORD, login, api };
JS
cd /workspace || exit 1
OUT=$(RAILS_ENV=development bin/rails runner /tmp/uiseed.rb 2>&1 | grep -E '^UISEED|Error|error' | head -5)
echo "$OUT EMAIL=ui@example.com PASSWORD=Passw0rd!long BASE=http://127.0.0.1:$PORT"
