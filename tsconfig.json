{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["runner", "evaluator", "researcher", "scripts", "tests", "storage"],
  "exclude": ["node_modules", "benchmark/starter", "evaluator/reference-app", "dashboard", "results"]
}
