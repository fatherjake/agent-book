#!/bin/sh
# /opt/frugal/task/services start|stop|status
# tiny needs no background services (the sim is an in-process cluster, started by `app start`).
# The runner calls `services start` right after creating the container; this only checks that the
# preinstalled dependencies are present, so a broken image fails fast as an infra error.
set -eu
case "${1:-status}" in
  start|status)
    [ -x /workspace/.venv/bin/python ] || { echo "services: /workspace/.venv missing" >&2; exit 1; }
    [ -d /workspace/ui/node_modules ] || { echo "services: /workspace/ui/node_modules missing" >&2; exit 1; }
    echo "services: ok (nothing to start)" ;;
  stop) echo "services: nothing to stop" ;;
  *) echo "usage: services start|stop|status" >&2; exit 2 ;;
esac
