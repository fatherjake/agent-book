#!/bin/bash
# /opt/frugal/task/app start|stop|status|logs [--port N] [--bots N] [--no-build]
#
# Serves tiny offline:
#   1. the sim: 4 validators, N market-making bots, a seeded fake price feed and the API on
#      127.0.0.1:8000 (`python -m sim --db ""`: no block log, every start is a fresh chain)
#   2. the UI: `npm run build` (tsc --noEmit + vite build into ui/dist), then `vite preview` on
#      0.0.0.0:PORT, which serves ui/dist and proxies /book, /ws and the other API routes to :8000
#      (the proxy table in ui/vite.config.ts)
#
#   start   do 1-2 in the background; return once the API and the UI both answer (idempotent)
#   stop    stop both
#   status  exit 0 if both answer, 3 otherwise
#   logs    tail the logs
#
# State/logs: /tmp/frugal-app/{sim,build,ui}.log and *.pid.
# Defaults: --port 3000, --bots 20. APP_START_TIMEOUT (seconds, default 300).
set -euo pipefail

cmd=${1:-}
shift || true
PORT=${PORT:-3000}
BOTS=${BOTS:-20}
BUILD=1
API_PORT=8000
while [ $# -gt 0 ]; do
  case "$1" in
    --port) PORT=$2; shift 2 ;;
    --port=*) PORT=${1#--port=}; shift ;;
    --bots) BOTS=$2; shift 2 ;;
    --bots=*) BOTS=${1#--bots=}; shift ;;
    --no-build) BUILD=0; shift ;;
    *) echo "app: unknown option $1" >&2; exit 1 ;;
  esac
done
STATE=/tmp/frugal-app
mkdir -p "$STATE"
cd /workspace

up() { curl -fsS -o /dev/null --max-time 5 "$1" 2>/dev/null; }
api_up() { up "http://127.0.0.1:$API_PORT/status"; }
ui_up() { up "http://127.0.0.1:$PORT/"; }

stop_pid() {
  local f=$STATE/$1.pid
  [ -f "$f" ] || return 0
  local pid
  pid=$(cat "$f")
  kill "$pid" 2>/dev/null || true
  for _ in $(seq 1 50); do kill -0 "$pid" 2>/dev/null || break; sleep 0.1; done
  kill -9 "$pid" 2>/dev/null || true
  rm -f "$f"
}

wait_for() {
  local what=$1 check=$2 pidf=$3 log=$4
  local deadline=$(( $(date +%s) + ${APP_START_TIMEOUT:-300} ))
  until $check; do
    if [ -f "$pidf" ] && ! kill -0 "$(cat "$pidf")" 2>/dev/null; then
      echo "app: $what exited during startup; last log lines:" >&2
      tail -n 40 "$log" >&2 || true
      exit 1
    fi
    if [ "$(date +%s)" -ge "$deadline" ]; then
      echo "app: $what not ready after ${APP_START_TIMEOUT:-300}s; last log lines:" >&2
      tail -n 40 "$log" >&2 || true
      exit 1
    fi
    sleep 0.5
  done
}

case "$cmd" in
  start)
    if ! api_up; then
      stop_pid sim
      setsid .venv/bin/python -m sim --validators 4 --bots "$BOTS" --db "" --api-port "$API_PORT" >"$STATE/sim.log" 2>&1 &
      echo $! >"$STATE/sim.pid"
      wait_for "the sim API" api_up "$STATE/sim.pid" "$STATE/sim.log"
    fi
    if ! ui_up; then
      stop_pid ui
      if [ "$BUILD" = 1 ]; then
        if ! (cd ui && npm run build) >"$STATE/build.log" 2>&1; then
          echo "app: npm run build failed; last log lines:" >&2
          tail -n 40 "$STATE/build.log" >&2
          exit 1
        fi
      fi
      (cd ui && setsid npx vite preview --host 0.0.0.0 --port "$PORT" --strictPort) >"$STATE/ui.log" 2>&1 &
      echo $! >"$STATE/ui.pid"
      wait_for "the UI server" ui_up "$STATE/ui.pid" "$STATE/ui.log"
    fi
    echo "app: up: UI http://127.0.0.1:$PORT  API http://127.0.0.1:$API_PORT (bots=$BOTS)"
    ;;
  stop)
    stop_pid ui
    stop_pid sim
    echo "app: stopped"
    ;;
  status)
    if api_up && ui_up; then echo "app: up"; else echo "app: down"; exit 3; fi
    ;;
  logs)
    tail -n 50 "$STATE"/*.log 2>/dev/null || echo "app: no logs"
    ;;
  *)
    echo "usage: app start|stop|status|logs [--port N] [--bots N] [--no-build]" >&2
    exit 2
    ;;
esac
