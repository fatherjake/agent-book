#!/bin/sh
# /opt/frugal/task/pw-node <script.js> [args...]
# Runs a Node script with `require('playwright')` resolvable and Chromium preinstalled (headless,
# no sandbox flags needed, /dev/shm use disabled). The container has no network: point it at
# http://127.0.0.1:<port> (e.g. after `app start`). Use CommonJS (`require`): NODE_PATH does not
# apply to ES module imports.
export NODE_PATH=/opt/frugal/pw/node_modules
export PLAYWRIGHT_BROWSERS_PATH=/opt/frugal/pw/browsers
export PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
exec /usr/local/bin/node --require /opt/frugal/task/pw-preload.cjs "$@"
