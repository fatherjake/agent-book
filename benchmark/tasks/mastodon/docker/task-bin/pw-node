#!/bin/sh
# /opt/frugal/task/pw-node <script.js> [args...]
# Runs a Node script on the private modern Node runtime (/opt/frugal/node, NOT the project's old
# node on PATH) with `require('playwright')` resolvable and Chromium preinstalled. Chromium is
# headless and runs without its own sandbox (Playwright's default), with /dev/shm use disabled.
# The container has no network: point it at http://127.0.0.1:<port> (e.g. `app start`).
# Use CommonJS (`require`), since NODE_PATH does not apply to ES module imports.
export NODE_PATH=/opt/frugal/pw/node_modules
export PLAYWRIGHT_BROWSERS_PATH=/opt/frugal/pw/browsers
export PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
exec /opt/frugal/node/bin/node --require /opt/frugal/task/pw-preload.cjs "$@"
