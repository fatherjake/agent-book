#!/bin/bash
# /opt/frugal/task/app start|run|stop|status|logs [--port N] [--no-sidekiq] [--skip-migrate]
#
# Serves the Mastodon checkpoint (plus whatever patch is applied to /workspace) in the Rails
# development environment, offline:
#   1. services start (Postgres + Redis, see /opt/frugal/task/services)
#   2. bin/rails db:migrate (development; the test DB is migrated lazily by rspec's
#      maintain_test_schema from db/schema.rb)
#   3. webpack: compiles the development packs into public/packs (bin/webpack). Rails then serves
#      them as static files; webpacker's own freshness check is satisfied, so no compile happens
#      inside a request.
#   4. puma (single mode, 0.0.0.0:PORT) and sidekiq (background jobs: timelines fan-out, etc.)
#
#   start   do 1-4, daemonise web + sidekiq, return once GET /about answers 200 (idempotent:
#           returns immediately if the app is already up on that port)
#   run     do 1-3, then run puma in the foreground (sidekiq in the background)
#   stop    stop web + sidekiq (services keep running)
#   status  exit 0 if the web server answers, 3 otherwise
#   logs    tail the logs
#
# State/logs: /tmp/frugal-app/{web,sidekiq,webpack,migrate}.log and *.pid.
# Env: PORT (default 3000), LOCAL_DOMAIN (default localhost:$PORT, Mastodon's dev default),
# APP_START_TIMEOUT (seconds, default 1800).
set -euo pipefail

cmd=${1:-}
shift || true
PORT=${PORT:-3000}
SIDEKIQ=1
MIGRATE=1
while [ $# -gt 0 ]; do
  case "$1" in
    --port) PORT=$2; shift 2 ;;
    --port=*) PORT=${1#--port=}; shift ;;
    --no-sidekiq) SIDEKIQ=0; shift ;;
    --skip-migrate) MIGRATE=0; shift ;;
    *) echo "app: unknown option $1" >&2; exit 1 ;;
  esac
done
export PORT
export BIND=0.0.0.0
export WEB_CONCURRENCY=0          # puma single mode (no forked workers) in development
export MAX_THREADS=${MAX_THREADS:-5}
export RAILS_ENV=development
export RAILS_LOG_TO_STDOUT=1
# Webpack (Mastodon 2018/2019) may need more than the default old-Node heap.
export NODE_OPTIONS=${NODE_OPTIONS:---max-old-space-size=3072}
STATE=/tmp/frugal-app
TIMEOUT=${APP_START_TIMEOUT:-1800}
mkdir -p "$STATE"
cd /workspace

log() { echo "app: $*" >&2; }
up() { [ "$(curl -s -o /dev/null -w '%{http_code}' --max-time 20 "http://127.0.0.1:$PORT/about" 2>/dev/null)" = 200 ]; }
alive() { [ -f "$1" ] && kill -0 "$(cat "$1")" 2>/dev/null; }

prepare() {
  /opt/frugal/task/services start >/dev/null
  if [ "$MIGRATE" = 1 ]; then
    log "db:migrate"
    bin/rails db:migrate >"$STATE/migrate.log" 2>&1 || { tail -n 40 "$STATE/migrate.log" >&2; log "db:migrate failed"; exit 1; }
  fi
  log "compiling webpack packs (development)"
  local t0=$SECONDS
  # Webpacker.compile is exactly what the dev server would do on the first request (bin/webpack
  # with NODE_ENV=development, then record the source digest), so requests never compile.
  # (`rails webpacker:compile` would force NODE_ENV=production on webpacker 3.x.)
  NODE_ENV=development bin/rails runner 'exit(Webpacker.compile ? 0 : 1)' >"$STATE/webpack.log" 2>&1 \
    || { tail -n 60 "$STATE/webpack.log" >&2; grep -iE 'error' log/development.log | tail -n 40 >&2 || true; log "webpack compile failed"; exit 1; }
  log "packs compiled in $((SECONDS - t0))s"
}

start_sidekiq() {
  [ "$SIDEKIQ" = 1 ] || return 0
  alive "$STATE/sidekiq.pid" && return 0
  setsid -f bash -c 'echo $$ > "$0/sidekiq.pid"; exec bundle exec sidekiq -c 5 -q default -q push -q pull -q mailers -q scheduler >"$0/sidekiq.log" 2>&1' "$STATE" </dev/null
}

stop_pidfile() {
  local f=$1
  if alive "$f"; then
    kill -TERM "$(cat "$f")" 2>/dev/null || true
    for _ in $(seq 1 100); do alive "$f" || break; sleep 0.1; done
    alive "$f" && kill -KILL "$(cat "$f")" 2>/dev/null || true
  fi
  rm -f "$f"
}

case "$cmd" in
  start)
    if up; then log "already serving on :$PORT"; exit 0; fi
    prepare
    start_sidekiq
    if ! alive "$STATE/web.pid"; then
      rm -f tmp/pids/server.pid
      setsid -f bash -c 'echo $$ > "$0/web.pid"; exec bundle exec puma -C config/puma.rb >"$0/web.log" 2>&1' "$STATE" </dev/null
    fi
    t0=$SECONDS
    until up; do
      if ! alive "$STATE/web.pid"; then tail -n 60 "$STATE/web.log" >&2; log "web server exited"; exit 1; fi
      if [ $((SECONDS - t0)) -ge "$TIMEOUT" ]; then tail -n 60 "$STATE/web.log" >&2; log "timed out waiting for :$PORT"; exit 1; fi
      sleep 1
    done
    log "serving http://0.0.0.0:$PORT (boot $((SECONDS - t0))s)"
    ;;
  run)
    prepare
    start_sidekiq
    rm -f tmp/pids/server.pid
    exec bundle exec puma -C config/puma.rb
    ;;
  stop)
    stop_pidfile "$STATE/web.pid"
    stop_pidfile "$STATE/sidekiq.pid"
    log "stopped"
    ;;
  status)
    if up; then echo "web: up on :$PORT"; else echo "web: down"; exit 3; fi
    alive "$STATE/sidekiq.pid" && echo "sidekiq: running" || echo "sidekiq: stopped"
    ;;
  logs)
    tail -n 100 "$STATE"/*.log
    ;;
  *)
    echo "usage: $0 start|run|stop|status|logs [--port N] [--no-sidekiq] [--skip-migrate]" >&2
    exit 1
    ;;
esac
