# Copy to .env. Loaded by the host-side CLIs only; never passed into any container.

# Claude subscription token for Claude Code (the default coding agent, configs/baseline): run
# `claude setup-token` and paste the printed token here. Read ONLY by the host gateway
# (runner/gateway.ts); every claude process and container gets a placeholder instead.
CLAUDE_CODE_OAUTH_TOKEN=

# Only for the api backend (configs/baseline-api) and other API-key providers.
ANTHROPIC_API_KEY=

# Host Claude Code binary (default ~/.local/bin/claude; must be the version pinned in runner/claude-code.ts)
# FRUGAL_CLAUDE_BIN=

# Optional overrides
# The coding agent's model is set per config (configs/<id>/config.json "model"), not here.
# Browser-agent evaluator model (default claude-sonnet-5-5)
# FRUGAL_EVALUATOR_MODEL=
# Research agent model (default from configs/research.json "researchModel")
# RESEARCH_MODEL=
# Results DB path (default results/benchmark.db)
# FRUGAL_DB_PATH=
# Set to 1 to stop the CLIs from running `caffeinate -i` on macOS
# FRUGAL_NO_CAFFEINATE=
