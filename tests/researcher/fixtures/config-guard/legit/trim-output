#!/usr/bin/env node
// PostToolUse hook (matcher Bash): replaces long Bash stdout/stderr with head + tail before the
// model sees it. Verified with Claude Code 2.1.325: hookSpecificOutput.updatedToolOutput replaces
// the tool result. Prints nothing (= no change) for short output.
let d = '';
process.stdin.on('data', (c) => (d += c)).on('end', () => {
  const i = JSON.parse(d || '{}');
  const r = i.tool_response;
  const max = Number(process.argv[2] || 2000);
  const cut = (s) => (typeof s === 'string' && s.length > max ? s.slice(0, max / 2) + `\n[... ${s.length - max} chars trimmed ...]\n` + s.slice(-max / 2) : s);
  if (r && typeof r === 'object' && ((r.stdout || '').length > max || (r.stderr || '').length > max)) {
    const out = { ...r, stdout: cut(r.stdout), stderr: cut(r.stderr) };
    // stderr on exit 0 never reaches the model; profiles parse this line to report the saving.
    process.stderr.write(`frugal: orig_chars=${(r.stdout || '').length + (r.stderr || '').length} new_chars=${out.stdout.length + out.stderr.length} tool_use_id=${i.tool_use_id || ''}\n`);
    process.stdout.write(JSON.stringify({ hookSpecificOutput: { hookEventName: 'PostToolUse', updatedToolOutput: out } }));
  }
});
